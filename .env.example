# Copy to .env.local and fill in. Never commit real keys.
OPENROUTER_API_KEY=
FAL_KEY=

# Optional overrides (verify model slugs on openrouter.ai/models and fal.ai/models)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
# FAL_TTS_MODEL=fal-ai/elevenlabs/tts/eleven-v3
# FAL_TTS_VOICE=Rachel

# PRODUCTION SAFETY: live mode spends credits. On Vercel it only works if this is set
# (and the dashboard asks for it). Leave unset to keep the public demo mock-only.
# LIVE_ACCESS_CODE=
